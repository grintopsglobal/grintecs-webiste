---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
---

<BaseLayout lang="id" title="404" noindex alternates={{ id: '/', en: '/' }}>
  <section class="container-x grid gap-12 py-20 md:grid-cols-2 md:py-28">
    {
      (['id', 'en'] as const).map((l) => (
        <div lang={l}>
          <p class="font-display text-6xl font-extrabold text-primary-700">404</p>
          {l === 'id' ? <h1 class="mt-4 text-3xl font-extrabold">{ui.id['404.title']}</h1> : <h2 class="mt-4 text-3xl font-extrabold">{ui.en['404.title']}</h2>}
          <p class="mt-3 text-lg text-muted">{ui[l]['404.text']}</p>
          <a href={localizePath(l)} class="btn-primary mt-8">{ui[l]['404.home']}</a>
        </div>
      ))
    }
  </section>
</BaseLayout>
