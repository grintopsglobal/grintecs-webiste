---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTA from '../../components/CTA.astro';
import type { Lang } from '../../i18n/ui';
import { localizePath, staticLangPaths } from '../../i18n/utils';
import { getPage } from '../../lib/content';
import { withBase } from '../../lib/url';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const about = await getPage(lang, 'about');
const home = await getPage(lang, 'home');
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---

<BaseLayout lang={lang} title={about.seo.title} description={about.seo.description}>
  <PageHeader title={about.heading} intro={about.intro} />

  <section class="container-x grid gap-10 py-14 md:py-20 lg:grid-cols-[4fr_8fr] lg:gap-16">
    <h2 class="text-3xl font-extrabold">{about.history.heading}</h2>
    <div class="prose-grintec max-w-[68ch]">
      {paragraphs(about.history.body).map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="on-dark bg-forest py-14 text-white md:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-sm font-semibold text-on-forest">{about.vision.heading}</h2>
        <p class="mt-4 font-display text-2xl leading-snug font-bold md:text-3xl">{about.vision.body}</p>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-on-forest">{about.mission.heading}</h2>
        <ol class="mt-4 space-y-4">
          {
            about.mission.items.map((m, i) => (
              <li class="grid grid-cols-[2rem_1fr] gap-2 text-lg leading-relaxed">
                <span class="font-display font-bold text-on-forest tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <span>{m}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="container-x py-14 md:py-20">
    <h2 class="text-3xl font-extrabold">{about.values.heading}</h2>
    <dl class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
      {
        about.values.items.map((v) => (
          <div class="border-t-2 border-primary pt-5">
            <dt class="font-display text-xl font-bold">{v.title}</dt>
            <dd class="mt-2 leading-relaxed text-muted">{v.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="bg-mist py-14 md:py-20">
    <div class="container-x">
      <h2 class="text-3xl font-extrabold">{about.team.heading}</h2>
      {about.team.intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{about.team.intro}</p>}
      {
        about.team.members.length > 0 && (
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {about.team.members.map((m) => (
              <li class="rounded-[var(--radius-card)] border border-line bg-white p-6">
                {m.photo ? (
                  <img src={withBase(m.photo)} alt={m.name} width="160" height="160" loading="lazy" class="size-20 rounded-full object-cover" />
                ) : (
                  <span class="flex size-20 items-center justify-center rounded-full bg-forest font-display text-xl font-bold text-white" aria-hidden="true">
                    {initials(m.name)}
                  </span>
                )}
                <p class="mt-5 font-display text-lg font-bold">{m.name}</p>
                <p class="text-sm font-semibold text-primary-700">{m.role}</p>
                {m.bio && <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{m.bio}</p>}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <CTA heading={home.cta.heading} text={home.cta.text} label={home.cta.buttonLabel} href={localizePath(lang, '/contact/')} />
</BaseLayout>
