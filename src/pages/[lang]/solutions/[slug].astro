---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DetailBody from '../../../components/DetailBody.astro';
import WorksSection from '../../../components/WorksSection.astro';
import type { Lang } from '../../../i18n/ui';
import { bodyHtml } from '../../../lib/url';
import { localizePath, useTranslations } from '../../../i18n/utils';
import { alternatesFor, byLang, findByKey, keyOf, worksFor } from '../../../lib/content';
import { locales } from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (lang) => (await byLang('solutions', lang)).map((entry) => ({ params: { lang, slug: entry.data.slug }, props: { entry } }))),
  );
  return paths.flat();
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props as { entry: CollectionEntry<'solutions'> };
const t = useTranslations(lang);
const services = await byLang('services', lang);
const works = await worksFor(lang, 'solutions', entry);
const related = entry.data.relatedServices
  .map((key) => findByKey(services, key))
  .filter((s) => s !== undefined)
  .map((s) => ({ href: localizePath(lang, `/services/${s.data.slug}/`), label: s.data.title }));
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.excerpt} image={entry.data.heroImage} alternates={await alternatesFor('solutions', keyOf(entry))}>
  <PageHeader title={entry.data.title} intro={entry.data.excerpt} image={entry.data.heroImage} back={{ href: localizePath(lang, '/solutions/'), label: t('solutions.title') }} />
  <DetailBody
    listTitle={t('common.outcomes')}
    list={entry.data.outcomes}
    related={{ title: t('common.relatedServices'), links: related }}
    cta={{ href: localizePath(lang, '/contact/'), label: t('common.discussThis') }}
  >
    <Fragment set:html={bodyHtml(entry)} />
  </DetailBody>
  <WorksSection lang={lang} items={works} />
</BaseLayout>
