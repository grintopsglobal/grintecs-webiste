---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import CTA from '../../../../components/CTA.astro';
import WorksSection from '../../../../components/WorksSection.astro';
import PricingGate from '../../../../components/PricingGate.astro';
import type { Lang } from '../../../../i18n/ui';
import { locales } from '../../../../i18n/ui';
import { bodyHtml } from '../../../../lib/url';
import { localizePath, useTranslations } from '../../../../i18n/utils';
import { byLang, getPage, getSettings, keyOf, parentOf, worksFor } from '../../../../lib/content';

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (lang) =>
      Promise.all(
        (await byLang('subservices', lang)).map(async (entry) => ({
          params: { lang, slug: (await parentOf(lang, entry)).data.slug, sub: entry.data.slug },
          props: { entry },
        })),
      ),
    ),
  );
  return paths.flat();
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props as { entry: CollectionEntry<'subservices'> };
const t = useTranslations(lang);
const { data } = entry;
const parent = await parentOf(lang, entry);
const parentPath = `/services/${parent.data.slug}/`;
const home = await getPage(lang, 'home');
const works = await worksFor(lang, 'subservices', entry);
const settings = await getSettings(lang);
const priceGateReady = data.priceGate && Boolean(settings.form.endpoint && settings.form.turnstileSiteKey);

// Bahasa lain: ke sub-layanan yang sama (dipasangkan lewat kunci file) bila ada terjemahannya, kalau tidak ke layanan induk.
const all = await getCollection('subservices');
const alternates = Object.fromEntries(
  await Promise.all(
    locales.map(async (l) => {
      const twin = all.find((e) => e.id === `${l}/${keyOf(entry)}`);
      const twinParent = twin ? (await parentOf(l, twin)).data.slug : parent.data.slug;
      return [l, twin ? `/services/${twinParent}/${twin.data.slug}/` : `/services/${twinParent}/`];
    }),
  ),
) as Record<Lang, string>;

const contactHref = `${localizePath(lang, '/contact/')}?service=${encodeURIComponent(data.title)}`;
---

<BaseLayout lang={lang} title={data.title} description={data.excerpt} image={data.heroImage} alternates={alternates}>
  <PageHeader title={data.title} image={data.heroImage} back={{ href: localizePath(lang, parentPath), label: parent.data.title }}>
    {data.tagline && <p class="mt-5 max-w-2xl font-display text-xl font-bold text-forest md:text-2xl">{data.tagline}</p>}
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{data.excerpt}</p>
    <a href={contactHref} class="btn-primary mt-8">{data.ctaLabel || t('common.discussThis')}</a>
  </PageHeader>

  {
    data.process.length > 0 && (
      <section class="container-x py-14 md:py-20" aria-labelledby="sub-process">
        <h2 id="sub-process" class="text-2xl font-extrabold md:text-3xl">{t('sub.process')}</h2>
        <ol class="mt-10 grid gap-8 border-l-2 border-line pl-6 sm:grid-cols-2 sm:border-l-0 sm:pl-0 lg:grid-cols-4 lg:gap-6">
          {data.process.map((step, i) => (
            <li class="relative sm:border-t-2 sm:border-line sm:pt-5">
              <span class="absolute top-1 -left-[1.95rem] block size-3 rotate-45 bg-primary sm:-top-[0.45rem] sm:left-0" aria-hidden="true" />
              <p class="font-display text-3xl font-extrabold text-primary-700 tabular-nums">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-1 text-lg font-bold">{step}</h3>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="border-y border-line bg-mist py-14 md:py-20">
    <div class="container-x grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
      <div>
        {
          data.deliverables.length > 0 && (
            <>
              <h2 class="text-2xl font-extrabold md:text-3xl">{t('sub.deliverables')}</h2>
              <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
                {data.deliverables.map((item) => (
                  <li class="slash leading-relaxed">{item}</li>
                ))}
              </ul>
            </>
          )
        }
        {
          entry.body?.trim() && (
            <div class="prose-grintec mt-12 max-w-[68ch]">
              <Fragment set:html={bodyHtml(entry)} />
            </div>
          )
        }
      </div>
      <aside class="space-y-8 lg:sticky lg:top-28 lg:self-start">
        {
          priceGateReady ? (
            <PricingGate
              lang={lang}
              priceKey={data.slug}
              endpoint={settings.form.endpoint!}
              siteKey={settings.form.turnstileSiteKey!}
              caption={data.pricing}
              contactHref={contactHref}
            />
          ) : (
            data.pricing && (
              <div class="rounded-[var(--radius-card)] border border-line bg-white p-6">
                <h2 class="text-lg font-bold">{t('sub.pricing')}</h2>
                <p class="mt-3 leading-relaxed text-muted">{data.pricing}</p>
              </div>
            )
          )
        }
        {
          data.faq.length > 0 && (
            <div>
              <h2 class="text-lg font-bold">{t('sub.faq')}</h2>
              <div class="mt-3 divide-y divide-line border-y border-line">
                {data.faq.map((f) => (
                  <details class="group">
                    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold [&::-webkit-details-marker]:hidden">
                      {f.q}
                      <svg class="size-4 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
                    </summary>
                    <p class="pb-4 leading-relaxed text-muted">{f.a}</p>
                  </details>
                ))}
              </div>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <WorksSection lang={lang} items={works} />
  <CTA heading={home.cta.heading} text={home.cta.text} label={data.ctaLabel || home.cta.buttonLabel} href={contactHref} />
</BaseLayout>
