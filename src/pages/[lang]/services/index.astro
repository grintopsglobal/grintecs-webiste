---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ServiceList from '../../../components/ServiceList.astro';
import CTA from '../../../components/CTA.astro';
import type { Lang } from '../../../i18n/ui';
import { localizePath, staticLangPaths, useTranslations } from '../../../i18n/utils';
import { byLang, getPage } from '../../../lib/content';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const items = (await byLang('services', lang)).map((e) => e.data);
const home = await getPage(lang, 'home');
---

<BaseLayout lang={lang} title={t('services.title')} description={t('services.intro')}>
  <PageHeader title={t('services.title')} intro={t('services.intro')} />
  <section class="container-x py-14 md:py-20">
    <ServiceList lang={lang} items={items} />
  </section>
  <CTA heading={home.cta.heading} text={home.cta.text} label={home.cta.buttonLabel} href={localizePath(lang, '/contact/')} />
</BaseLayout>
