---
interface Props {
  listTitle?: string;
  list?: string[];
  related?: { title: string; links: { href: string; label: string }[] };
  cta: { href: string; label: string };
}
const { listTitle, list = [], related, cta } = Astro.props;
---

<section class="container-x grid gap-12 py-14 md:py-20 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:gap-16">
  <div>
    <div class="prose-grintec max-w-[68ch]">
      <slot />
    </div>
  </div>
  <aside class="space-y-10 lg:sticky lg:top-28 lg:self-start">
    {
      list.length > 0 && (
        <div class="rounded-[var(--radius-card)] border border-line bg-mist p-6">
          <h2 class="text-lg font-bold">{listTitle}</h2>
          <ul class="mt-4 space-y-3">
            {list.map((item) => (
              <li class="slash leading-relaxed">{item}</li>
            ))}
          </ul>
        </div>
      )
    }
    {
      related && related.links.length > 0 && (
        <div>
          <h2 class="text-lg font-bold">{related.title}</h2>
          <ul class="mt-3">
            {related.links.map((l) => (
              <li>
                <a href={l.href} class="link inline-flex min-h-11 items-center">{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <a href={cta.href} class="btn-primary w-full">{cta.label}</a>
  </aside>
</section>
