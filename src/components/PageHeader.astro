---
import Stripes from './Stripes.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  intro?: string;
  back?: { href: string; label: string };
  /** Ilustrasi di sisi kanan (mis. dari company profile). Tanpa ini, motif garis logo yang tampil. */
  image?: string;
}
const { title, intro, back, image } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-line bg-mist">
  {!image && <Stripes id="page-stripes" class="absolute -right-24 bottom-0 -z-10 hidden h-full w-[38%] opacity-25 md:block" />}
  <div class:list={['container-x py-12 md:py-16', image && 'grid items-center gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,42%)] md:gap-12']}>
    <div>
      {back && <a href={back.href} class="link mb-2 inline-flex min-h-11 items-center text-sm">← {back.label}</a>}
      <h1 class="max-w-3xl text-4xl font-extrabold md:text-5xl">{title}</h1>
      {intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{intro}</p>}
      <slot />
    </div>
    {
      image && (
        <img
          src={withBase(image)}
          alt=""
          width="1600"
          height="1000"
          fetchpriority="high"
          decoding="async"
          class="aspect-[8/5] w-full rounded-[var(--radius-card)] object-contain"
        />
      )
    }
  </div>
</section>
